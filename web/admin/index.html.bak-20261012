<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZS Live 管理后台</title>
<style>
:root {
  --bg:#0d1117; --panel:#161b22; --panel2:#1c2129; --border:#30363d;
  --text:#e6edf3; --muted:#8b949e; --accent:#2f81f7; --ok:#3fb950; --warn:#d29922; --err:#f85149;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;font-size:14px}
a{color:var(--accent);text-decoration:none}

/* 布局 */
#app{display:none;height:100vh}
#login{display:flex;align-items:center;justify-content:center;height:100vh}
aside{width:210px;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column}
aside .logo{padding:18px 16px;font-size:16px;font-weight:700;border-bottom:1px solid var(--border)}
aside .logo small{display:block;font-size:10px;color:var(--muted);font-weight:400;margin-top:2px}
aside nav{flex:1;padding:8px}
aside nav a{display:block;padding:9px 12px;border-radius:6px;color:var(--muted);margin-bottom:2px;cursor:pointer}
aside nav a:hover{background:var(--panel2);color:var(--text)}
aside nav a.on{background:rgba(47,129,247,.15);color:var(--accent)}
aside .foot{padding:12px 16px;border-top:1px solid var(--border);font-size:11px;color:var(--muted)}
main{flex:1;overflow:auto;padding:22px 26px}
.row{display:flex;gap:16px;flex-wrap:wrap}
.card{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:16px;margin-bottom:16px;flex:1;min-width:260px}
.card h3{font-size:13px;color:var(--muted);font-weight:500;margin-bottom:12px}
.big{font-size:26px;font-weight:600}
.big small{font-size:12px;color:var(--muted);font-weight:400}

/* 表格 */
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)}
th{color:var(--muted);font-weight:500;font-size:12px}
tr:hover td{background:var(--panel2)}
.badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:11px}
.b-ok{background:rgba(63,185,80,.15);color:var(--ok)}
.b-warn{background:rgba(210,153,34,.15);color:var(--warn)}
.b-err{background:rgba(248,81,73,.15);color:var(--err)}
.b-info{background:rgba(47,129,247,.15);color:var(--accent)}
.b-muted{background:rgba(139,148,158,.15);color:var(--muted)}

/* 表单 */
input,select{background:var(--panel2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:7px 10px;font-size:13px;width:100%}
input:focus,select:focus{outline:none;border-color:var(--accent)}
label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px}
button{background:var(--accent);border:none;border-radius:6px;color:#fff;padding:7px 14px;cursor:pointer;font-size:13px}
button:hover{filter:brightness(1.15)}
button.ghost{background:transparent;border:1px solid var(--border);color:var(--text)}
button.danger{background:var(--err)}
button.mini{padding:3px 9px;font-size:12px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
.form-grid .full{grid-column:1/-1}
.actions{margin-top:14px;display:flex;gap:8px}

/* 登录 */
.login-box{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:30px;width:340px}
.login-box h2{font-size:18px;margin-bottom:6px}
.login-box p{color:var(--muted);font-size:12px;margin-bottom:16px}

h2.page{font-size:17px;margin-bottom:16px;font-weight:600}
.hint{font-size:12px;color:var(--muted);margin-top:6px}
.toast{position:fixed;top:16px;right:16px;padding:10px 16px;border-radius:8px;background:var(--panel);border:1px solid var(--border);z-index:99;display:none}
</style>
</head>
<body>

<!-- 登录 -->
<div id="login">
  <div class="login-box">
    <h2>ZS Live 管理后台</h2>
    <p>UE 云渲染调度平台 · 不依赖 PixelStreaming</p>
    <label>用户名</label>
    <input id="li-user" value="admin">
    <label>密码</label>
    <input id="li-pass" type="password" placeholder="admin123">
    <div class="actions"><button style="width:100%" onclick="doLogin()">登 录</button></div>
  </div>
</div>

<!-- 主界面 -->
<div id="app">
  <aside>
    <div class="logo">ZS Live<small>UE 云渲染调度平台</small></div>
    <nav id="nav"></nav>
    <div class="foot" id="side-info"></div>
  </aside>
  <main id="main"></main>
</div>

<div class="toast" id="toast"></div>

<script src="/admin/admin.js"></script>
</body>
</html>
