# ============ ZS Live 调度服务配置 ============
# 复制为 .env 后按需修改

# 服务端口
PORT=3100

# 对外访问地址（浏览器可达），留空则自动探测本机局域网 IP
PUBLIC_HOST=

# MediaMTX
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WHEP_PORT=8890
MEDIAMTX_API_PORT=9997

# 同时服务的最大会话数（并发 UE 实例数上限）
MAX_INSTANCES=3

# 每模板预热实例数
WARM_COUNT=1

# 实例空闲多久后回收（秒）
IDLE_TIMEOUT=300

# 排队位置推送间隔（秒）
QUEUE_INTERVAL=5

# 管理员初始账号（仅首次建库时生效）
ADMIN_USER=admin
ADMIN_PASS=admin123

# 数据库文件
DB_PATH=./data/zslive.db

# ============ 集群配置（单机部署保持注释即可） ============
# 角色：standalone=单机（默认） / master=集群管理节点 / worker=渲染节点
# CLUSTER_ROLE=
# 集群共享密钥（master 与所有 worker 必须一致；master 建议自己生成一串随机字符）
# CLUSTER_TOKEN=
# worker 内部 API 端口（master 经此调用，默认 3120）
# CLUSTER_INTERNAL_PORT=3120
# 节点标识与显示名（可选，默认主机名）
# NODE_ID=
# NODE_NAME=
# worker 对浏览器暴露的地址（可选，默认同 PUBLIC_HOST/PORT）
# NODE_PUBLIC_HOST=
# NODE_PUBLIC_PORT=
